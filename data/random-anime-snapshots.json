"https://lain.bgm.tv/r/200/pic/cover/l/a3/76/132165_zlLZE.jpg","grid":"https://lain.bgm.tv/r/100/pic/cover/l/a3/76/132165_zlLZE.jpg","large":"https://lain.bgm.tv/pic/cover/l/a3/76/132165_zlLZE.jpg","medium":"https://lain.bgm.tv/r/800/pic/cover/l/a3/76/132165_zlLZE.jpg","common":"https://lain.bgm.tv/r/400/pic/cover/l/a3/76/132165_zlLZE.jpg"},"image":"https://lain.bgm.tv/pic/cover/l/a3/76/132165_zlLZE.jpg","summary":"　　重生的美人鱼在海里快乐地生活着，可当她目睹海面上一艘大船遭遇风暴，船长的女儿苏珊落水遇危时，她纯真的本性和内心深处的秘密又被触发，不顾海神严厉告诫出手挽救了苏珊。在把苏珊送回海港的路上，她们遭遇海盗惊心动魄的追逐，聪明调皮的美人鱼把海盗戏弄得焦头烂额。被船长抓到船上来的海盗们因为宠物猴的帮助成功越狱控制了众水手和大船。美人鱼费劲尽周折帮众人脱险。她无意中听到海盗们的谈话，感觉海盗们也并不是无药可治的坏人，想要帮助挽救他们。此时大船触礁沉没，船长和海盗们都被冲上一个小岛，这时岛上危险的巨人成为了大家共同的敌人……","name":"美人鱼之海盗来袭","name_cn":"美人鱼之海盗来袭","tags":[{"name":"剧场版","count":3,"total_count":654395},{"name":"2015","count":2,"total_count":63931},{"name":"中国","count":2,"total_count":24447},{"name":"国产","count":2,"total_count":147806},{"name":"子供向","count":1,"total_count":10125}],"infobox":[{"key":"中文名","value":"美人鱼之海盗来袭"},{"key":"别名","value":[{"v":"The Little Mermaid: Attack of The Pirates"}]},{"key":"上映年度","value":"2015-07-31"},{"key":"片长","value":"85分钟"},{"key":"话数","value":"1"},{"key":"类型","value":"喜剧 / 奇幻 / 冒险"},{"key":"制片国家/地区","value":"中国大陆"},{"key":"语言","value":"汉语普通话"},{"key":"导演","value":"邱浩强"},{"key":"出品人","value":"陈晴"},{"key":"监制","value":"邱浩强、宋雅云"},{"key":"制片人","value":"杜杨"},{"key":"执行导演","value":"廖光华"},{"key":"脚本","value":"陈晴"},{"key":"制作总监","value":"孙勇刚"},{"key":"制作统筹","value":"董可"},{"key":"剪辑","value":"龚晓敏"},{"key":"监制助理","value":"陈浩、吴世扬"},{"key":"制片助理","value":"廖淑娟"},{"key":"海报设计","value":"王缓"},{"key":"渲染合成主管","value":"王文林"},{"key":"模型主管","value":"陈平"},{"key":"动画主管","value":"隗亮"},{"key":"特效主管","value":"张坚"},{"key":"视觉主管","value":"李智"},{"key":"音乐","value":"钱墨子、韦旺"},{"key":"剧务","value":"刘文迪"}],"rating":{"rank":0,"total":3,"count":{"1":2,"2":0,"3":0,"4":0,"5":1,"6":0,"7":0,"8":0,"9":0,"10":0},"score":2.3},"collection":{"on_hold":1,"dropped":10,"wish":2,"collect":2,"doing":1},"id":132165,"eps":1,"total_episodes":1,"meta_tags":["剧场版","子供向","中国"],"volumes":0,"series":false,"locked":false,"nsfw":false,"type":2}},{"date":"2026-11-21","poolKey":"before-2000","poolLabel":"2000 年前","algorithmVersion":"anime-daily-year-v1","anime":{"date":"1999-07-05","platform":"TV","images":{"small":"https://lain.bgm.tv/r/200/pic/cover/l/11/5a/28956_27tfu.jpg","grid":"https://lain.bgm.tv/r/100/pic/cover/l/11/5a/28956_27tfu.jpg","large":"https://lain.bgm.tv/pic/cover/l/11/5a/28956_27tfu.jpg","medium":"https://lain.bgm.tv/r/800/pic/cover/l/11/5a/28956_27tfu.jpg","common":"https://lain.bgm.tv/r/400/pic/cover/l/11/5a/28956_27tfu.jpg"},"image":"https://lain.bgm.tv/pic/cover/l/11/5a/28956_27tfu.jpg","summary":"　　故事发生在商朝末年，是时妖孽横行、纣王荒淫无道、残害忠良，人民怨声载道，正是风雨欲来，暗潮涌动。西伯侯姬昌当廷直谏触怒了纣王，被囚禁在朝歌，幸为奇士姜子牙所救。大难不死的姬昌拜子牙为相，招募天下英雄，举起了反商大旗。听闻消息的纣王勃然大怒，派出兵马征讨西歧，姜子牙率领众将奋勇抵抗。纣王奢侈无度，商朝军心涣散，周军却气势如虹，攻克潼关、火烧绝龙岭、直取朝歌，纣王见大势已去，火烧摘星楼、自焚而亡。姬发被推举为王，史称“周武王”。周武王建造气势宏大的封神碑，册封英勇阵亡的将士，缅怀他们的功绩……","name":"封神榜传奇","name_cn":"封神榜传奇","tags":[{"name":"国产","count":65,"total_count":164460},{"name":"童年","count":43,"total_count":94362},{"name":"上海美术电影制片厂","count":31,"total_count":10722},{"name":"TV","count":24,"total_count":1449232},{"name":"1999","count":14,"total_count":13779},{"name":"没看完系列","count":9,"total_count":133},{"name":"奇幻","count":9,"total_count":493940},{"name":"热血","count":8,"total_count":219175},{"name":"动画","count":6,"total_count":35988},{"name":"战斗","count":4,"total_count":491349},{"name":"上美","count":3,"total_count":652},{"name":"神话","count":3,"total_count":1653},{"name":"国产动画","count":3,"total_count":5821},{"name":"中国","count":3,"total_count":32667},{"name":"原创","count":3,"total_count":637779},{"name":"1999年7月","count":2,"total_count":86},{"name":"子供向","count":1,"total_count":13813},{"name":"bilibili","count":1,"total_count":3550},{"name":"7分","count":1,"total_count":3842},{"name":"2003","count":1,"total_count":17236},{"name":"王根发","count":1,"total_count":4},{"name":"1990s","count":1,"total_count":1557},{"name":