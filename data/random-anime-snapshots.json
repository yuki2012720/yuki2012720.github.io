这三只无法无天的小坏蛋。一场“大人”和“小鬼”的激烈较量就此展开……","name":"Triplet Trouble","name_cn":"三只小猫","tags":[{"name":"短片","count":3,"total_count":105159},{"name":"猫和老鼠","count":2,"total_count":1653},{"name":"1952","count":1,"total_count":116},{"name":"短編","count":1,"total_count":148},{"name":"剧场版","count":1,"total_count":741938},{"name":"搞笑","count":1,"total_count":662102},{"name":"1950s","count":1,"total_count":184}],"infobox":[{"key":"中文名","value":"三只小猫"},{"key":"上映年度","value":"1952年4月19日"},{"key":"片长","value":"7分钟"},{"key":"IMDb","value":"tt0045262"},{"key":"话数","value":"1"}],"rating":{"rank":0,"total":10,"count":{"1":0,"2":0,"3":0,"4":0,"5":1,"6":3,"7":3,"8":2,"9":1,"10":0},"score":6.9},"collection":{"on_hold":0,"dropped":2,"wish":0,"collect":15,"doing":0},"id":634614,"eps":1,"total_episodes":1,"meta_tags":["剧场版"],"volumes":0,"series":false,"locked":false,"nsfw":false,"type":2}}]